# Konfigurasi koneksi PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/NAMA_DATABASE

# Secret JWT HMAC (minimal 32 byte; gunakan nilai acak dan rahasiakan)
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_BYTE

# Listener HTTP Backend API
APP_HOST=127.0.0.1
APP_PORT=4000

# Konfigurasi Frontend
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000

# Koneksi Redis untuk session Frontend
REDIS_URL=redis://127.0.0.1:6379
